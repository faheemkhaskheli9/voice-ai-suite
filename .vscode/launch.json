{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: pytest tests/",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-q"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Django: runserver",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/manage.py",
            "args": ["runserver"],
            "cwd": "${workspaceFolder}/src",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
